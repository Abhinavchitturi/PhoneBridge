<?xml version="1.0" encoding="utf-8"?>
<!-- Types into the focused text box and taps/swipes for you while you control the phone from the Mac; no events are collected. -->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeViewFocused"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:canPerformGestures="true"
    android:accessibilityFlags="flagRetrieveInteractiveWindows"
    android:canRetrieveWindowContent="true"
    android:description="@string/typing_service_description"
    android:notificationTimeout="100" />
